# StEP1 backend — every variable app/config.py reads. Copy to .env and edit.
# Every value has a safe default; with no .env at all the app boots in local
# mode against a Homebrew Postgres database named `step1`.

# --- Environment -----------------------------------------------------------
# dev  -> secrets come from this file / the environment
# prod -> secrets come from AWS Secrets Manager (<SECRETS_PREFIX>/<NAME>),
#         falling back to the environment
APP_ENV=dev
SECRETS_PREFIX=step1

# --- Database --------------------------------------------------------------
# Homebrew Postgres 16 on the host (OS user, no password):
DATABASE_URL=postgresql+psycopg://localhost:5432/step1
# docker compose's Postgres, from the host (compose maps it to 5433):
# DATABASE_URL=postgresql+psycopg://step1:step1-local-only@localhost:5433/step1
# RDS: append ?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT=10

# Tests only (conftest.py): the database pytest migrates and truncates.
# TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/step1_test

# --- Auth ------------------------------------------------------------------
# local   -> bcrypt passwords + HS256 tokens signed with JWT_SECRET
# cognito -> validate Cognito RS256 JWTs against the pool JWKS (unconfigured in v1)
AUTH_MODE=local
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRY_MINUTES=720
PASSWORD_MIN_LENGTH=8
# bcrypt work factor. Leave at 12 unless you have measured a reason not to.
BCRYPT_ROUNDS=12
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# --- HTTP ------------------------------------------------------------------
# Comma-separated browser origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000
# This API's base URL as the browser sees it (local-mode resume upload URLs).
PUBLIC_API_BASE=http://localhost:8000

# --- Resume storage --------------------------------------------------------
# local -> files under UPLOAD_DIR, uploaded via PUT /profile/resume/local/{key}
# s3    -> presigned S3 PUTs to S3_BUCKET (SSE-KMS when KMS_KEY_ID is set)
STORAGE_BACKEND=local
UPLOAD_DIR=data/uploads
S3_BUCKET=
KMS_KEY_ID=
PRESIGN_EXPIRY_SECONDS=300
RESUME_MAX_BYTES=5242880
RESUME_MIN_TEXT_CHARS=200
# Seconds a resume may take to parse before the attempt is abandoned.
RESUME_PARSE_TIMEOUT_S=10

# --- Sources (python -m app.sources.backfill) ------------------------------
# The Simplify repo name rolls forward every recruiting cycle.
SIMPLIFY_REPO=SimplifyJobs/Summer2027-Internships
VANSHB03_REPO=vanshb03/Summer2027-Internships
SOURCE_BRANCH=dev
SOURCE_FETCH_TIMEOUT_S=60
DEACTIVATE_GUARD_RATIO=0.5

# --- Automatic refresh -----------------------------------------------------
# true  -> the API re-runs the backfill for any source whose last successful
#          run is older than INGEST_INTERVAL_HOURS. Checked at startup and then
#          every INGEST_CHECK_MINUTES, so a laptop that was off catches up when
#          the API next starts. A failed run is retried at the next check.
# false -> refresh only when you run `python -m app.sources.backfill`.
# Defaults to true when APP_ENV=dev and false otherwise.
AUTO_INGEST=true
INGEST_INTERVAL_HOURS=24
INGEST_CHECK_MINUTES=30

# --- Matching / timeline ---------------------------------------------------
POSTING_MAX_AGE_DAYS=120
SCORES_MAX_AGE_HOURS=24
GHOST_AFTER_DAYS=30
