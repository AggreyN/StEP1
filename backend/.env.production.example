# StEP1 backend: the production configuration.
#
# Every variable the container reads, with the value production needs. This
# is the one supported production setup: one task on ECS Fargate behind an
# Application Load Balancer, PostgreSQL on RDS, resumes in S3. It is described
# step by step in AWS_SETUP.md, and the reasons are in docs/ARCHITECTURE.md.
#
# This file is documentation. It is never loaded: a container gets its
# settings from the task definition, where
#
#   - a line marked [secret] goes under `secrets`, with `valueFrom` the name
#     of an SSM Parameter Store SecureString parameter (or a Secrets Manager
#     ARN). ECS fetches it and hands it to the container as an environment
#     variable. It is never written into the task definition itself.
#   - every other line goes under `environment`, as written here.
#
# Angle brackets and CHANGE-ME mark what you must fill in. With APP_ENV=prod
# the app refuses to start if one of them is missing or unsafe, and names it.

# --- Environment ------------------------------------------------------------
APP_ENV=prod
# env: secrets arrive as environment variables, injected by ECS as above.
# The container makes no AWS call and needs no permission to learn them.
SECRETS_BACKEND=env
# Used only when SECRETS_BACKEND=secretsmanager: <SECRETS_PREFIX>/<NAME>.
# SECRETS_PREFIX=step1
AWS_REGION=us-east-1

# --- Database ---------------------------------------------------------------
# [secret] The RDS endpoint. sslmode=require is checked for at start.
DATABASE_URL=postgresql+psycopg://step1:<CHANGE-ME-password>@<rds-endpoint>:5432/step1?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT=10
# How long /health waits for the database before answering 503. Keep it under
# the load balancer's health check timeout.
HEALTH_DB_TIMEOUT_S=2

# --- Sign-in ----------------------------------------------------------------
# local:   this service keeps passwords (bcrypt) and signs tokens itself.
# cognito: a Cognito user pool does both; this service only checks tokens.
AUTH_MODE=local
# [secret] Used when AUTH_MODE=local. At least 32 characters. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=<CHANGE-ME-generate-a-long-random-value>
JWT_EXPIRY_MINUTES=720
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
# Used when AUTH_MODE=cognito. The pool id begins with the region.
# COGNITO_USER_POOL_ID=us-east-1_<pool>
# COGNITO_APP_CLIENT_ID=<app-client-id>
# Where the pool's public keys are read from. Leave both unset to fetch them
# from the pool over https, which a task with internet access can do.
# COGNITO_JWKS_PATH=/srv/jwks.json
# COGNITO_JWKS_URL=https://<other-host>/jwks.json
# COGNITO_JWKS_TIMEOUT_S=5

# --- Rate limits ------------------------------------------------------------
# Per client address. Counters are kept in the task's memory, which is right
# for one task. See backend/README.md before running more than one.
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/hour
DELETE_ACCOUNT_RATE_LIMIT=5/hour
STATS_RATE_LIMIT=60/minute
# Per signed-in person and, separately, per client address.
REVIEW_RATE_LIMIT=5/day

# --- Behind the load balancer -----------------------------------------------
# The load balancer connects to the task, so the address on the socket is the
# load balancer's. It appends the real client's address to X-Forwarded-For.
# true + 1 reads the last entry, the one the load balancer wrote. Anything a
# client put in that header itself is to the left of it and is never used.
TRUST_PROXY=true
# 1 for load balancer -> task. 2 only if CloudFront is put in front of the
# load balancer.
TRUSTED_PROXY_HOPS=1

# --- Addresses --------------------------------------------------------------
# The frontend's origin, https, with no path. Comma-separated if several.
ALLOWED_ORIGINS=https://step1careers.com
# This API's own public address.
PUBLIC_API_BASE=https://api.step1careers.com
# The frontend's address, for the link to the admin page in review emails.
SITE_URL=https://step1careers.com

# --- Admin and notifications ------------------------------------------------
# Who may open the admin pages, comma-separated. In cognito mode the pool
# must have verified the address. Empty: nobody (the app logs a warning).
ADMIN_EMAILS=ayertey.narh.24@gmail.com
# SNS topic the owner's email is subscribed to; each review is published to
# it. The task role needs sns:Publish on it. Empty: reviews are stored but
# not emailed (the app logs a warning).
NOTIFY_TOPIC_ARN=arn:aws:sns:us-east-1:720682843719:step1-owner-notifications

# --- Resumes ----------------------------------------------------------------
STORAGE_BACKEND=s3
S3_BUCKET=<CHANGE-ME-bucket-name>
# Leave unset to encrypt with S3-managed keys (SSE-S3). Set to a KMS key's
# ARN to use that key instead.
# KMS_KEY_ID=
# Never set in production. For an S3-compatible store under test.
# S3_ENDPOINT_URL=
# Used only when STORAGE_BACKEND=local.
# UPLOAD_DIR=data/uploads
PRESIGN_EXPIRY_SECONDS=300
RESUME_MAX_BYTES=5242880
RESUME_MIN_TEXT_CHARS=200
RESUME_PARSE_TIMEOUT_S=10

# --- Listings ---------------------------------------------------------------
# true: this service refreshes the listings itself, once a day. It checks
# when it starts and every INGEST_CHECK_MINUTES after. This is the recommended
# setup for a single always-on task.
# false: something else runs `python -m app.sources.backfill` on a schedule.
AUTO_INGEST=true
INGEST_INTERVAL_HOURS=24
INGEST_CHECK_MINUTES=30
# Seconds a refresh in progress is given to stop when the task is stopped.
# Must fit, with the server's 10 seconds of draining, inside the task's stop
# timeout (30 seconds by default).
INGEST_SHUTDOWN_GRACE_S=15
SIMPLIFY_REPO=SimplifyJobs/Summer2027-Internships
VANSHB03_REPO=vanshb03/Summer2027-Internships
SOURCE_BRANCH=dev
# The other lists the board is built from (docs/ARCHITECTURE.md §2). Slugs
# and branches roll forward each cycle.
SIMPLIFY_NEWGRAD_REPO=SimplifyJobs/New-Grad-Positions
SIMPLIFY_NEWGRAD_BRANCH=dev
SPEEDYAPPLY_AI_REPO=speedyapply/2027-AI-College-Jobs
SPEEDYAPPLY_BRANCH=main
JOBRIGHT_DATA_ANALYSIS_REPO=jobright-ai/2026-Data-Analysis-Internship
JOBRIGHT_BUSINESS_ANALYST_REPO=jobright-ai/2026-Business-Analyst-Internship
JOBRIGHT_PRODUCT_REPO=jobright-ai/2026-Product-Management-Internship
JOBRIGHT_BRANCH=master
# Off: the Zapply list is CC BY-NC-SA 4.0 (non-commercial, share-alike).
ZAPPLY_ENABLED=false
ZAPPLY_REPO=zapplyjobs/Internships-2027
ZAPPLY_BRANCH=main
SOURCE_FETCH_TIMEOUT_S=60
DEACTIVATE_GUARD_RATIO=0.5

# --- Matching and the timeline ----------------------------------------------
POSTING_MAX_AGE_DAYS=120
SCORES_MAX_AGE_HOURS=24
GHOST_AFTER_DAYS=30
