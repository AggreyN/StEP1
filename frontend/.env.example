# "mock" runs the whole UI against in-browser fixtures (src/lib/mock/).
# Point at the FastAPI backend to use real data:
#   NEXT_PUBLIC_API_BASE=http://localhost:8000
# Unset is treated as "mock" (with a console warning).
NEXT_PUBLIC_API_BASE=mock

# Only when resumes upload straight to S3: the bucket's origin, so the
# Content-Security-Policy lets the browser PUT there. Leave unset when the
# API stores uploads itself (local mode).
#   NEXT_PUBLIC_UPLOAD_ORIGIN=https://my-bucket.s3.amazonaws.com
