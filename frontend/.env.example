# Settings are read when the site is built and baked into the files.
# Copy to .env.local for development. Nothing here is a secret: every
# NEXT_PUBLIC_ value ends up in the browser.

# "mock" runs the whole UI against in-browser fixtures (src/lib/mock/).
# Otherwise the API's origin, with no path:
#   NEXT_PUBLIC_API_BASE=http://localhost:8000
#   NEXT_PUBLIC_API_BASE=https://api.step1careers.com
# Unset is treated as "mock" (with a console warning).
NEXT_PUBLIC_API_BASE=mock

# Only when resumes upload straight to S3: the bucket's origin, so the
# Content-Security-Policy lets the browser PUT there. Leave unset when the
# API stores uploads itself.
#   NEXT_PUBLIC_UPLOAD_ORIGIN=https://<bucket>.s3.amazonaws.com

# How people sign in: "local" (email and password, the default) or "cognito".
#   NEXT_PUBLIC_AUTH_MODE=local

# Local mode only: "open" (the default) or "closed", which hides Register.
#   NEXT_PUBLIC_REGISTRATION=open

# Cognito mode only. All four are needed.
#   The user pool's OWN domain (a Cognito prefix or custom domain, not
#   step1careers.com itself):
#   NEXT_PUBLIC_COGNITO_DOMAIN=https://<prefix>.auth.<region>.amazoncognito.com
#   The app client id (a public client, with no secret):
#   NEXT_PUBLIC_COGNITO_CLIENT_ID=
#   Where Cognito returns after sign-in. Must be an allowed callback URL of
#   the app client, exactly, with no trailing slash:
#   NEXT_PUBLIC_COGNITO_REDIRECT_URI=https://step1careers.com/auth/callback
#   Where Cognito returns after sign-out. Must be an allowed sign-out URL:
#   NEXT_PUBLIC_COGNITO_LOGOUT_URI=https://step1careers.com/login
